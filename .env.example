# Local fixture mode needs no cloud credentials.
ECR_LIVE_PROVIDER=fixture

# Optional Vertex AI configuration. Replace placeholders only in your shell or
# in an ignored local .env file; never commit credentials.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
ECR_LLM_MODEL=gemini-3.5-flash
ECR_EMBEDDING_MODEL=gemini-embedding-001
ECR_ROLE_TIMEOUT_SECONDS=120
